# Server
PORT=8001
PUBLIC_BASE_URL=https://media-import-service-xxxxx.asia-south1.run.app

# Temp + ffmpeg (Cloud Run image ships /usr/bin/ffmpeg)
TEMP_DIR=/tmp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Optional rotating proxies (comma-separated). Leave empty for direct-only.
# PROXIES=http://user:pass@host:port,http://user:pass@host2:port

# Platform Netscape cookie files (mount via Secret Manager / volume — never commit)
# COOKIES_DIR=/secrets/cookies
# COOKIES_FILE=/secrets/cookies.txt

# Rate limiting + resource caps
RATE_LIMIT_PER_MINUTE=40
MAX_CONCURRENT_FFMPEG=5
FFMPEG_TIMEOUT_SECONDS=300
MAX_THREAD_WORKERS=50

# Manual import test
# TEST_REEL_URL=https://www.instagram.com/reel/XXXX/
