# yt-dlp import (Instagram works direct; YouTube/TikTok/Snapchat need residential proxy on Cloud Run)

# REQUIRED for YouTube / TikTok / Snapchat (Geonode proxy dashboard — NOT the Scraper API key)
GEONODE_PROXY_USERNAME=
GEONODE_PROXY_PASSWORD=
GEONODE_PROXY_HOST=proxy.geonode.io
GEONODE_PROXY_PORT=9000
# Or single URL:
# GEONODE_PROXY_URL=http://username:password@proxy.geonode.io:9000

GEONODE_ALLOW_DIRECT=false
GEONODE_MAX_ATTEMPTS=3

# Optional legacy scraper key (not used for yt-dlp download path)
# GEONODE_API_KEY=

# Optional YouTube cookies file path (only if bot checks persist even with proxy)
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt

# Free proxy fallback when no Geonode proxy (unreliable; dev only)
# YT_DLP_PROXY_FALLBACK_ATTEMPTS=3

# TEST_REEL_URL=https://www.youtube.com/watch?v=...
