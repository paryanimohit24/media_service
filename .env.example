# yt-dlp import — direct server IP first (Instagram reels use phone IP in the Flutter app)

# YouTube test: NewPipe Extractor instead of yt-dlp (set false to restore yt-dlp/innertube)
USE_NEWPIPE_EXTRACTOR=true
NEWPIPE_CLI_JAR=/app/newpipe-cli.jar

# Optional manual proxy for YouTube/TikTok when datacenter IP is blocked
# YT_DLP_PROXY=http://user:pass@host:port

# Optional YouTube cookies file path
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt

# Free proxy fallback (unreliable; dev only)
# YT_DLP_AUTO_PROXY=false
# YT_DLP_PROXY_FALLBACK_ATTEMPTS=3

# TEST_REEL_URL=https://www.instagram.com/reel/...
