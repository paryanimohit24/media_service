# Geonode Scraper API (residential proxy page extraction — replaces free proxy pool)
GEONODE_API_KEY=
GEONODE_ENABLED=true
GEONODE_EXTRACT_URL=https://scraper.geonode.io/v1/extract
GEONODE_RENDER_JS=true
GEONODE_PROCESSING_MODE=async
GEONODE_PROXY_COUNTRY=US
GEONODE_PROXY_TYPE=residential
GEONODE_ALLOW_DIRECT=false
GEONODE_MAX_ATTEMPTS=3
# Fast import: yt-dlp audio first (default). Use geonode_first only if yt-dlp blocked.
IMPORT_STRATEGY=ytdlp_first
GEONODE_TRY_EMBED=false
GEONODE_POLL_INTERVAL_SEC=5
GEONODE_POLL_TIMEOUT_SEC=180

# Optional: Geonode HTTP proxy for yt-dlp (YouTube/TikTok fallback — separate proxy dashboard creds)
# GEONODE_PROXY_URL=http://username:password@proxy.geonode.io:9000
# GEONODE_PROXY_USERNAME=
# GEONODE_PROXY_PASSWORD=
# GEONODE_PROXY_HOST=proxy.geonode.io
# GEONODE_PROXY_PORT=9000

# Legacy free proxy pool (disabled when GEONODE_API_KEY is set)
# YT_DLP_AUTO_PROXY=false
# YT_DLP_PROXY_FALLBACK_ATTEMPTS=0

# Optional admin override:
# YT_DLP_PROXY=http://user:pass@host:port

# Test URL for test_import.py (Instagram / YouTube / TikTok / Snapchat)
# TEST_REEL_URL=https://www.instagram.com/reel/XXXXX/
